<husk:Page x:Class="FMMS.Views.DiskExplorerPage"
		   xmlns="https://github.com/avaloniaui"
		   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		   xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
		   xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
		   xmlns:vm="clr-namespace:FMMS.ViewModels"
		   xmlns:models="clr-namespace:FMMS.Models"
		   xmlns:converters="clr-namespace:FMMS.Converters"
		   Padding="20"
		   d:DesignHeight="600"
		   d:DesignWidth="900"
		   x:DataType="vm:DiskExplorerViewModel"
		   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		   IsBackButtonVisible="False"
		   mc:Ignorable="d">

	<Grid RowDefinitions="Auto,Auto,*,Auto">
		<!-- Карточка с верхней информацией -->
		<husk:Card Grid.Row="0"
				   Margin="20,20,20,10"
				   Padding="20"
				   Classes="Elevated">
			<StackPanel Orientation="Vertical" Spacing="15">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<fi:SymbolIcon FontSize="28"
								   Foreground="{StaticResource AccentFillColorDefaultBrush}"
								   Symbol="FolderSearch" />
					<TextBlock VerticalAlignment="Center"
							   FontSize="26"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
							   Text="Анализ папок" />
				</StackPanel>

				<Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
					<TextBox Grid.Column="0"
							 Classes="Filled"
							 IsReadOnly="True"
							 Text="{Binding SelectedFolderPath, Mode=OneWay}"
							 Watermark="Выбранная папка для анализа..." />
					<Button Grid.Column="1"
							Classes="Primary"
							Command="{Binding SelectAndAnalyzeFolderCommand}"
							ToolTip.Tip="Выбрать папку и начать анализ">
						<fi:SymbolIcon FontSize="18" Symbol="FolderOpen" />
					</Button>
				</Grid>

				<!-- Информационные теги -->
				<StackPanel Orientation="Horizontal" Spacing="10">
					<husk:Tag Content="{Binding TotalFileCount, StringFormat='Файлов обнаружено: {0}'}" />
					<husk:Tag Content="{Binding TotalFolderCount, StringFormat='Папок обнаружено: {0}'}" />
					<husk:Tag Content="{Binding TotalSizeInBytes, Converter={x:Static converters:SizeConverter.Instance}, StringFormat='Общий размер: {0}'}" />
				</StackPanel>

				<TextBlock Text="{Binding FolderMessage}" />
			</StackPanel>
		</husk:Card>

		<!-- Карточка с таблицей -->
		<husk:Card Grid.Row="2"
				   Margin="20,0,20,10"
				   Padding="15"
				   Classes="Elevated">
			<ScrollViewer>
				<Grid RowDefinitions="Auto,*">
					<TextBlock
					Grid.Row="0"
					Margin="0,0,0,10"
					Text="{Binding FolderMessage}" />

					<DataGrid Grid.Row="1"
							  Name="FoldersDataGrid"
							  ItemsSource="{Binding Folders}"
							  AutoGenerateColumns="False"
							  CanUserResizeColumns="True"
							  IsReadOnly="True"
							  SelectionMode="Extended"
							  KeyDown="DataGrid_KeyDown"
							  SelectionChanged="DataGrid_SelectionChanged"
							  CopyingRowClipboardContent="FilesDataGrid_CopyingRowClipboardContent">

						<DataGrid.ContextFlyout>
							<MenuFlyout>
								<MenuItem Command="{Binding ContextMenuOpenFolderCommand}">
									<MenuItem.Header>
										<StackPanel Orientation="Horizontal">
											<husk:IconLabel Icon="Open" Text="Открыть папку" VerticalAlignment="Center"/>
											<TextBlock Text="Ctrl+O" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
								<MenuItem Command="{Binding ContextMenuOpenContainingFolderCommand}">
									<MenuItem.Header>
										<StackPanel Orientation="Horizontal">
											<husk:IconLabel Icon="OpenFolder" Text="Открыть содержащую папку" VerticalAlignment="Center"/>
											<TextBlock Text="Ctrl+Shift+O" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
								<Separator />
								<MenuItem Command="{Binding ContextMenuCopyPathsCommand}">
									<MenuItem.Header>
										<StackPanel Orientation="Horizontal">
											<husk:IconLabel Icon="Copy" Text="Копировать пути" VerticalAlignment="Center"/>
											<TextBlock Text="Ctrl+C" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
								<MenuItem Command="{Binding ContextMenuCopyPathsAsTsvCommand}">
									<MenuItem.Header>
										<StackPanel Orientation="Horizontal">
											<husk:IconLabel Icon="CopySelect" Text="Копировать как TSV" VerticalAlignment="Center"/>
											<TextBlock Text="Ctrl+Shift+C" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
										</StackPanel>
									</MenuItem.Header>
								</MenuItem>
								<Separator />
							</MenuFlyout>
						</DataGrid.ContextFlyout>

						<DataGrid.Columns>
							<DataGridTextColumn Header="Путь"
												Binding="{Binding RelativePath}"
												Width="*" />
							<DataGridTextColumn Header="Размер"
												Binding="{Binding SizeFormatted}"
												SortMemberPath="SizeInBytes"
												Width="Auto" />
							<DataGridTextColumn Header="Файлов"
												Binding="{Binding FileCount}"
												Width="Auto" />
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</ScrollViewer>
		</husk:Card>

		<!-- Карточка с кнопкой и индикатором загрузки -->
		<husk:Card Grid.Row="3"
				   Margin="20,0,20,20"
				   Padding="20"
				   Classes="Elevated">
			<Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
				<Button Grid.Column="0"
						HorizontalAlignment="Stretch"
						Classes="Primary"
						Command="{Binding AnalyzeFolderCommand}">
					<StackPanel
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="8">
						<fi:SymbolIcon
						VerticalAlignment="Center"
						FontSize="16"
						Symbol="PlayCircle" />
						<TextBlock VerticalAlignment="Center" Text="Начать обработку файлов" />
					</StackPanel>
				</Button>
				<Button Grid.Column="1"
						Padding="10,0,10,0"
						Command="{Binding SaveResultsCommand}"
						ToolTip.Tip="Сохранить результаты">
					<fi:SymbolIcon FontSize="18" Symbol="ArrowExportUp" />
				</Button>
			</Grid>
		</husk:Card>
	</Grid>
</husk:Page>